# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Virtual environments
/.venv/
/venv/
/env/
/ENV/

# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Packaging and build output
/build/
/dist/
/develop-eggs/
/eggs/
/.eggs/
/sdist/
/wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

