.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
pytestdebug.log

# Local databases and runtime output
*.db
*.db-journal
*.sqlite
*.sqlite3
*.log
/logs/

# IDE and editor metadata
.idea/
.vscode/
.vs/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# Operating-system files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

